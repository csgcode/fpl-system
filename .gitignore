.venv/
__pycache__/
*.pyc
.pytest_cache/

# raw snapshot archives stay on disk, out of git
data/raw/**/.archive/

# session credentials — secrets, never committed (data/auth.example.json is the template)
data/auth.json

# raw browser captures used to build auth.json — bearer tokens in plaintext
curl-request
*.curl

# live eval runs: transcripts, scorecards, workspace diffs
evals/out/

# season store: derived from data/raw, rebuilt by `fpl store sync`
data/store/
